apiVersion: apps/v1
kind: Deployment
metadata:
  name: class-nginx
spec:
  replicas: 1
  selector:
    matchLabels:
      app: class-nginx
  template:
    metadata:
      labels:
        app: class-nginx
    spec:
      serviceAccountName: class-controller
      containers:
        - name: controller
          image: registry.k8s.io/ingress-nginx/controller:v1.15.1@sha256:594ceea76b01c592858f803f9ff4d2cb40542cae2060410b2c95f75907d659e1
          args:
            - /nginx-ingress-controller
            - --controller-class=k8s.io/ingress-nginx
            - --ingress-class=nginx
            - --watch-ingress-without-class=true
            - --watch-namespace={{ .Namespace }}
            - --update-status=false
            - --election-id=class-nginx-leader
          env:
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
          ports:
            - containerPort: 80
              name: http
          readinessProbe:
            httpGet:
              path: /healthz
              port: 10254
            periodSeconds: 2
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              add: [NET_BIND_SERVICE]
              drop: [ALL]
            runAsGroup: 82
            runAsUser: 101
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
---
apiVersion: v1
kind: Service
metadata:
  name: class-nginx
spec:
  type: NodePort
  selector:
    app: class-nginx
  ports:
    - port: 80
      targetPort: http
      nodePort: 30080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: class-traefik
spec:
  replicas: 1
  selector:
    matchLabels:
      app: class-traefik
  template:
    metadata:
      labels:
        app: class-traefik
    spec:
      serviceAccountName: class-controller
      containers:
        - name: controller
          image: {{ .TraefikImage | quote }}
          imagePullPolicy: Never
          args:
            - --entrypoints.web.address=:8000
            - --entrypoints.health.address=:8082
            - --ping=true
            - --ping.entrypoint=health
            - --log.level=DEBUG
            - --providers.kubernetesingressnginx=true
            - --providers.kubernetesingressnginx.controllerclass=k8s.io/ingress-nginx
            - --providers.kubernetesingressnginx.ingressclass=nginx
            - --providers.kubernetesingressnginx.ingressclassbyname=false
            - --providers.kubernetesingressnginx.watchingresswithoutclass=true
            - --providers.kubernetesingressnginx.watchnamespace={{ .Namespace }}
          ports:
            - containerPort: 8000
              name: http
          readinessProbe:
            httpGet:
              path: /ping
              port: 8082
            periodSeconds: 2
---
apiVersion: v1
kind: Service
metadata:
  name: class-traefik
spec:
  type: NodePort
  selector:
    app: class-traefik
  ports:
    - port: 80
      targetPort: http
      nodePort: 30081
